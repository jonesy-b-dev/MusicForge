<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicForge</title>
    <script type="importmap"></script>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MusicForge.Web.styles.css" asp-append-version="true" />
</head>
    <header>
	    <nav class="navbar">
        <div class="navbar-content">
            <a href="/" class="navbar-brand">
                <svg style="width: 1.5rem; height: 1.5rem; color: #F5B800;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" />
                </svg>
                <span class="navbar-brand-text">Audio<span class="navbar-accent">Forge</span></span>
            </a>

            <div class="navbar-menu">
                <a asp-page="/Privacy" class="navbar-link">Articles</a>
                <a asp-page="/tools/chord-builder" class="navbar-link">Chord Builder</a>
                <a asp-page="/tools/scale-builder" class="navbar-link">Scale Builder</a>
                <a asp-page="/tools/fretboard-learner" class="navbar-link">Fretboard Learner</a>

				@if (User.Identity.IsAuthenticated)
				{
					<button class="btn-login">
						<svg style="width: 1rem; height: 1rem;" xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 640 640" fill="currentColor" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="32"
								  d="M320 312C386.3 312 440 258.3 440 192C440 125.7 386.3 72 320 72C253.7 72 200 125.7 200 192C200 258.3 253.7 312 320 312zM290.3 368C191.8 368 112 447.8 112 546.3C112 562.7 125.3 576 141.7 576L498.3 576C514.7 576 528 562.7 528 546.3C528 447.8 448.2 368 349.7 368L290.3 368z"/>
						</svg>
						<a class="nav-link text-dark" asp-area="" asp-page="/Account">Account</a>
					</button>
					<button class="btn-login">
						<svg style="width: 1rem; height: 1rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
						</svg>
						<a class="nav-link text-dark" asp-area="" asp-page="/Logout">Logout</a>
					</button>
				}
				else
				{
					<button class="btn-login">
						<svg style="width: 1rem; height: 1rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
						</svg>
						<a class="nav-link text-dark" asp-area="" asp-page="/Login">Login</a>
					</button>
				}
</div>
            </div>
        </div>
    </nav>
    </header>
	<body>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    <footer class="border-top footer text-muted">
		<div class="footer-bottom">
			<p>&copy; 2026 AudioForge. All rights reserved.</p>
		</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
