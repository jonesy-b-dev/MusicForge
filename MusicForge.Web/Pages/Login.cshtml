@page
@model LoginModel
@{
}
<div class="loginContainer">
	<h3> Login to MusicForge</h3>
	<hr>
	<form method="post" novalidate>
		<div class="form-group-login">
			<label>Email address</label>
			<input type="email" class="form-control" asp-for="UserLoginModel.Email">
			<span class="inputError" asp-validation-for="UserLoginModel.Email"></span>
		</div>
		<div class="form-group-login">
			<label>Password</label>
			<input type="password" class="form-control" asp-for="UserLoginModel.Password">
			<span class="inputError" asp-validation-for="UserLoginModel.Password"></span>
		</div>
		<div class="mt-4" style="display: flex; gap: 0.5rem;justify-content: center;">
			<button type="submit" class="btn btn-primary mt-2 mb-2">Login</button>
		</div>
		<div style="display: flex; justify-content: center">
			No account yet? <a asp-area="" asp-page="/Register">Register</a>
		</div>
	</form>
</div>
