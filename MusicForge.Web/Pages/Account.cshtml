@page
@model MusicForge.Web.Pages.AccountModel
@using MusicForge.Domain.Models;
@{
}
<head>
    <link rel="stylesheet" href="~/css/accountPage.css">
</head>
<body>
    <div class="container">
        <!-- Profile Header -->
        <div class="profile-header">
            <div class="profile-header-content">
                <!-- Avatar -->
                <div class="profile-avatar">AT</div>

                <!-- User Info -->
                <div class="profile-info">
                    <div class="profile-name-row">
                        <h1 class="profile-name">@Model.loggedInUser.FirstName @Model.loggedInUser.LastName</h1>
                        <span class="profile-badge">@Model.loggedInUser.Role</span>
                    </div>
                    <p class="profile-email">@Model.loggedInUser.Email</p>
                    <p class="profile-join-date">
                        <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Member since January 2025
                    </p>
                </div>

                <!-- Quick Stats -->
                <div class="profile-stats">
                    <div class="profile-stat">
                        <div class="profile-stat-number">122</div>
                        <div class="profile-stat-label">Sessions</div>
                    </div>
                    <div class="profile-stat">
                        <div class="profile-stat-number">40.7h</div>
                        <div class="profile-stat-label">Practice</div>
                    </div>
                    <div class="profile-stat">
                        <div class="profile-stat-number">3</div>
                        <div class="profile-stat-label">Saved</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tool Practice Activity -->
        <div class="articles-section">
            <h2 class="section-header">
                <svg style="width: 1.5rem; height: 1.5rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                Tool Practice Activity
            </h2>

            <div class="tools-grid">
                <!-- Tool 1: Chord Builder -->
                <div class="tool-card">
                    <div class="tool-card-content">
                        <div class="tool-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" />
                            </svg>
                        </div>

                        <div class="tool-details">
                            <h3 class="tool-name">Chord Builder</h3>

                            <div class="tool-stats-grid">
                                <div>
                                    <div class="tool-stat-label">Sessions</div>
                                    <div class="tool-stat-value">47</div>
                                </div>
                                <div>
                                    <div class="tool-stat-label">Hours</div>
                                    <div class="tool-stat-value">12.5</div>
                                </div>
                                <div>
                                    <div class="tool-stat-label">Last Used</div>
                                    <div class="tool-stat-small">2 hours ago</div>
                                </div>
                            </div>

                            <div class="progress-bar-container">
                                <div class="progress-bar-header">
                                    <span>Progress</span>
                                    <span>75%</span>
                                </div>
                                <div class="progress-bar-track">
                                    <div class="progress-bar-fill" style="width: 75%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tool 2: Scale Builder -->
                <div class="tool-card">
                    <div class="tool-card-content">
                        <div class="tool-icon">
						<svg style="width: 2rem; height: 2rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8" d="M1 5h22M1 9h22M1 13h22M1 17h22M1 21h22"/>
						  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
						</svg>
                        </div>

                        <div class="tool-details">
                            <h3 class="tool-name">Scale Builder</h3>

                            <div class="tool-stats-grid">
                                <div>
                                    <div class="tool-stat-label">Sessions</div>
                                    <div class="tool-stat-value">32</div>
                                </div>
                                <div>
                                    <div class="tool-stat-label">Hours</div>
                                    <div class="tool-stat-value">8.3</div>
                                </div>
                                <div>
                                    <div class="tool-stat-label">Last Used</div>
                                    <div class="tool-stat-small">1 day ago</div>
                                </div>
                            </div>

                            <div class="progress-bar-container">
                                <div class="progress-bar-header">
                                    <span>Progress</span>
                                    <span>60%</span>
                                </div>
                                <div class="progress-bar-track">
                                    <div class="progress-bar-fill" style="width: 60%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tool 3: Fretboard learner -->
                <div class="tool-card">
                    <div class="tool-card-content">
                        <div class="tool-icon">
							<svg width="2rem" height="2rem" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path fill-rule="evenodd" fill="#F5B800" clip-rule="evenodd" d="M23.4472 2.3944C23.9242 2.15593 24.1301 1.58518 23.9153 1.09713C23.7005 0.609073 23.1405 0.375428 22.6425 0.56607L19.8928 1.6187C19.608 1.72775 18.9672 1.99921 18.6912 2.68384C18.5231 3.10071 18.4968 3.56242 18.6133 3.99405L15.7344 6.68451C15.6728 6.39913 15.576 6.11448 15.4398 5.83417C14.7718 4.45946 13.1758 3.87733 11.7211 4.0467C10.1921 4.22474 8.65936 5.21488 7.85421 7.13944C7.84561 7.16 7.8377 7.18083 7.83049 7.20192C7.34308 8.6278 6.2307 9.39943 4.65121 9.63989C1.87867 10.062 -0.120942 12.5729 0.106341 15.3656C0.480446 19.9624 4.09479 23.5767 8.69154 23.9508C11.4842 24.1781 13.9952 22.1785 14.4173 19.4059C14.5483 18.5452 14.7855 17.7716 15.1578 17.211C15.5071 16.6851 15.9663 16.3511 16.6447 16.274C18.2609 16.0904 19.2642 15.1161 19.5137 13.9241C19.7384 12.8509 19.3077 11.5446 18.1347 11.0517C17.0726 10.6054 16.1949 10.9874 15.6921 11.2062L15.6919 11.2063C15.6624 11.2191 15.6342 11.2314 15.6074 11.2429C15.0942 11.4627 14.9405 11.4905 14.6709 11.3546C14.3976 11.2168 14.3143 11.0492 14.2952 10.9629C14.2804 10.8955 14.283 10.7964 14.3964 10.6722L19.9023 5.52684C20.5167 5.8123 21.2696 5.70161 21.7765 5.19478C22.2175 4.75369 22.5251 4.19699 22.6636 3.58878L22.87 2.68301L23.4472 2.3944ZM12.9894 9.24994C12.9713 9.26758 12.9539 9.28574 12.9373 9.30438C12.3951 9.88713 12.1782 10.6492 12.3421 11.3932C12.5093 12.152 13.0436 12.7741 13.7707 13.1406C14.9115 13.7155 15.8386 13.3196 16.3949 13.0813C16.9794 12.8309 17.1196 12.7945 17.36 12.8955C17.4396 12.929 17.6353 13.1359 17.5561 13.5143C17.5017 13.7741 17.2709 14.19 16.4189 14.2868C15.0668 14.4404 14.1158 15.165 13.4918 16.1045C12.8909 17.0092 12.5919 18.1078 12.44 19.1049C12.1749 20.8465 10.5921 22.0989 8.85377 21.9574C5.23355 21.6628 2.39438 18.8236 2.09975 15.2034C1.95828 13.4651 3.21068 11.8823 4.95223 11.6171C7.07768 11.2935 8.92196 10.149 9.71104 7.88343C10.2416 6.63975 11.1537 6.12628 11.9524 6.03328C12.8314 5.93094 13.4503 6.31595 13.6409 6.70824C14.003 7.45347 13.7956 8.44372 13.0038 9.23545C12.999 9.24027 12.9942 9.2451 12.9894 9.24994ZM9.20712 12.7929C8.81659 12.4023 8.18343 12.4023 7.7929 12.7929C7.40238 13.1834 7.40238 13.8166 7.7929 14.2071L9.2929 15.7071C9.68343 16.0976 10.3166 16.0976 10.7071 15.7071C11.0976 15.3166 11.0976 14.6834 10.7071 14.2929L9.20712 12.7929ZM9.70712 17.2929L8.20712 15.7929C7.81659 15.4023 7.18343 15.4023 6.7929 15.7929C6.40238 16.1834 6.40238 16.8166 6.7929 17.2071L8.2929 18.7071C8.68343 19.0976 9.31659 19.0976 9.70712 18.7071C10.0976 18.3166 10.0976 17.6834 9.70712 17.2929Z"/>
							</svg>
                        </div>

                        <div class="tool-details">
                            <h3 class="tool-name">Fretbaord leaner</h3>

                            <div class="tool-stats-grid">
                                <div>
                                    <div class="tool-stat-label">Sessions</div>
                                    <div class="tool-stat-value">28</div>
                                </div>
                                <div>
                                    <div class="tool-stat-label">Hours</div>
                                    <div class="tool-stat-value">15.7</div>
                                </div>
                                <div>
                                    <div class="tool-stat-label">Last Used</div>
                                    <div class="tool-stat-small">3 days ago</div>
                                </div>
                            </div>

                            <div class="progress-bar-container">
                                <div class="progress-bar-header">
                                    <span>Progress</span>
                                    <span>85%</span>
                                </div>
                                <div class="progress-bar-track">
                                    <div class="progress-bar-fill" style="width: 85%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Articles Grid -->
        <div class="articles-grid">
            <!-- Saved Articles -->
            <div class="articles-section">
                <h2 class="section-header">
                    <svg style="width: 1.5rem; height: 1.5rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                    Saved Articles (3)
                </h2>

                <div class="article-list">
                    <!-- Saved Article 1 -->
                    <div class="article-card">
                        <div class="article-card-header">
                            <div style="flex: 1;">
                                <a href="/article/1" class="article-title">Mastering the Art of Compression</a>
                                <p class="article-author">By Sarah Mitchell</p>
                                <div class="article-meta">
                                    <span class="article-category">Mixing</span>
                                    <span class="article-meta-item">
                                        <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        8 min
                                    </span>
                                    <span>Saved May 10, 2026</span>
                                </div>
                            </div>
                            <button class="bookmark-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Saved Article 2 -->
                    <div class="article-card">
                        <div class="article-card-header">
                            <div style="flex: 1;">
                                <a href="/article/2" class="article-title">Essential Vocal Recording Techniques</a>
                                <p class="article-author">By Mike Johnson</p>
                                <div class="article-meta">
                                    <span class="article-category">Recording</span>
                                    <span class="article-meta-item">
                                        <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        12 min
                                    </span>
                                    <span>Saved May 8, 2026</span>
                                </div>
                            </div>
                            <button class="bookmark-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <!-- Saved Article 3 -->
                    <div class="article-card">
                        <div class="article-card-header">
                            <div style="flex: 1;">
                                <a href="/article/3" class="article-title">Understanding Frequency Spectrum</a>
                                <p class="article-author">By David Chen</p>
                                <div class="article-meta">
                                    <span class="article-category">Theory</span>
                                    <span class="article-meta-item">
                                        <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                        </svg>
                                        10 min
                                    </span>
                                    <span>Saved May 5, 2026</span>
                                </div>
                            </div>
                            <button class="bookmark-btn">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Written Articles -->
			@if (@Model.loggedInUser.Role == UserRoles.Writer){

            <div class="articles-section">
                <h2 class="section-header">
                    <svg style="width: 1.5rem; height: 1.5rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    My Articles (3)
                </h2>

                <div class="article-list">
                    <!-- Written Article 1 -->
                    <div class="article-card">
                        <div class="article-card-header">
                            <h3 class="article-title">My Journey with Audio Production</h3>
                            <span class="article-status published">Published</span>
                        </div>

                        <div class="article-stats">
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                April 28, 2026
                            </span>
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                1,243 views
                            </span>
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                                </svg>
                                89 likes
                            </span>
                        </div>

                        <div class="article-actions">
                            <button class="btn btn-primary">Edit</button>
                            <button class="btn btn-secondary">View</button>
                        </div>
                    </div>

                    <!-- Written Article 2 -->
                    <div class="article-card">
                        <div class="article-card-header">
                            <h3 class="article-title">Tips for Better Home Studio Setup</h3>
                            <span class="article-status published">Published</span>
                        </div>

                        <div class="article-stats">
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                April 15, 2026
                            </span>
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                2,156 views
                            </span>
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                                </svg>
                                145 likes
                            </span>
                        </div>

                        <div class="article-actions">
                            <button class="btn btn-primary">Edit</button>
                            <button class="btn btn-secondary">View</button>
                        </div>
                    </div>

                    <!-- Written Article 3 (Draft) -->
                    <div class="article-card">
                        <div class="article-card-header">
                            <h3 class="article-title">Advanced EQ Techniques</h3>
                            <span class="article-status draft">Draft</span>
                        </div>

                        <div class="article-stats">
                            <span class="article-meta-item">
                                <svg class="icon-sm" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                Draft
                            </span>
                        </div>

                        <div class="article-actions">
                            <button class="btn btn-primary">Continue Editing</button>
                        </div>
                    </div>

                    <!-- Write New Article Button -->
                    <button class="btn btn-full">
						<a class="nav-link text-dark" asp-area="" asp-page="/CreateArticle">+ Create new article</a>
					</button>
                </div>
            </div>
			}
        </div>
    </div>
</body>
</html>

