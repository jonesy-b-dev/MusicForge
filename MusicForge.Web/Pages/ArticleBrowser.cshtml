<!-- ARTICLES GRID -->
<div class="articles-container">
	<div class="articles-grid">

		<!-- Card 1 -->
		@foreach (Article article in Model.mockArticles)
		{
			<article class="article-card">
				<a href="/articles/1" class="card-link">
					<div class="card-category cat-theory">
						<svg width="14" height="14" fill="none" stroke="#4A5D3E" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round"
								  d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z" />
						</svg>
						<span>Theory</span>
					</div>
					<div class="card-body">
						<div class="card-title">@article.Title</div>
						<div class="card-excerpt">Dive deep into the world of jazz harmony and learn how to construct
							compelling chord progressions that capture the essence of the genre.</div>
							<div class="card-meta">
								<div class="card-meta-row">
									<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"
										 viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round"
											  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
									</svg>
									Miles Carter
								</div>
								<div class="card-meta-row">
									<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"
										 viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round"
											  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
									8 min read &bull; April 10, 2026
								</div>
							</div>
						</div>
						<div class="card-read-more">Read Article &rarr;</div>
					</a>
					<div class="card-vote">
						<div class="vote-row">
							<button class="vote-btn" aria-label="Upvote">
								<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
									 viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
								</svg>
							</button>
							@if (article.Upvotes >= 0)
							{
								<span class="vote-count">+@article.Upvotes</span>
							}
							else
							{
								<span class="vote-count">@article.Upvotes</span>
							}

							<button class="vote-btn" aria-label="Downvote">
								<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
									 viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
								</svg>
							</button>
						</div>
					</div>
				</article>
			}
		</div>
	</div>
